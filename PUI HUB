    PercentTxt.Text = "1%"
    PercentTxt.TextColor3 = Color3.fromRGB(255, 85, 85)
    PercentTxt.Font = Enum.Font.GothamBold
    PercentTxt.TextSize = 22
    PercentTxt.Parent = Box

    local BarBg = Instance.new("Frame")
    BarBg.Size = UDim2.new(1, -24, 0, 10)
    BarBg.Position = UDim2.new(0, 12, 1, -26)
    BarBg.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    BarBg.BorderSizePixel = 0
    BarBg.Parent = Box

    local BarBgCorner = Instance.new("UICorner")
    BarBgCorner.CornerRadius = UDim.new(1, 0)
    BarBgCorner.Parent = BarBg

    local BarFill = Instance.new("Frame")
    BarFill.Size = UDim2.new(0.01, 0, 1, 0)
    BarFill.BackgroundColor3 = Color3.fromRGB(255, 65, 65)
    BarFill.BorderSizePixel = 0
    BarFill.Parent = BarBg

    local BarFillCorner = Instance.new("UICorner")
    BarFillCorner.CornerRadius = UDim.new(1, 0)
    BarFillCorner.Parent = BarFill

    local steps = {
        { target = 25, text = "กำลังตรวจสอบตัวละครและบริการ..." },
        { target = 55, text = "กำลังดาวน์โหลด Fluent UI..." },
        { target = 85, text = "กำลังติดตั้งฟังก์ชันสายโหด..." },
        { target = 100, text = "ดาวน์โหลดเสร็จสมบูรณ์!" }
    }

    local currentPercent = 1
    local function SetProgress(p, msg)
        currentPercent = math.clamp(p, 1, 100)
        PercentTxt.Text = tostring(currentPercent) .. "%"
        StatusTxt.Text = string.format("%s (%d%%)", msg, currentPercent)
        BarFill.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
    end

    for i = 1, 25 do
        SetProgress(i, steps[1].text)
        task.wait(0.015)
    end

    local fluentLoaded, saveLoaded, ifaceLoaded
    local loadDone = false

    task.spawn(function()
        local ok1, res1 = pcall(function()
            return loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
        end)
        if ok1 then fluentLoaded = res1 end

        local ok2, res2 = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
        end)
        if ok2 then saveLoaded = res2 end

        local ok3, res3 = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()
        end)
        if ok3 then ifaceLoaded = res3 end

        loadDone = true
    end)

    for i = 26, 55 do
        SetProgress(i, steps[2].text)
        task.wait(0.02)
    end

    while not loadDone and currentPercent < 75 do
        SetProgress(currentPercent + 1, steps[2].text)
        task.wait(0.04)
    end

    local startMid = math.min(currentPercent + 1, 85)
    for i = startMid, 85 do
        SetProgress(i, steps[3].text)
        task.wait(0.015)
    end

    for i = 86, 100 do
        SetProgress(i, steps[4].text)
        task.wait(0.015)
    end

    task.wait(0.25)
    LoaderGui:Destroy()

    return fluentLoaded, saveLoaded, ifaceLoaded
end

