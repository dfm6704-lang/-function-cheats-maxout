local uiVisible = true

local function SetWindowVisible(state)
    uiVisible = state
    if Window.Root then
        Window.Root.Visible = uiVisible
    end
    if Window.Minimized and uiVisible then
        Window:Minimize()
    end
end

local function CreateFloatingToggle()
    local targetParent = (gethui and gethui()) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

    local oldToggle = targetParent:FindFirstChild("PUIHubPersistentToggle")
    if oldToggle then oldToggle:Destroy() end

    local ToggleGui = Instance.new("ScreenGui")
    ToggleGui.Name = "PUIHubPersistentToggle"
    ToggleGui.ResetOnSpawn = false
    ToggleGui.IgnoreGuiInset = true
    ToggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ToggleGui.Parent = targetParent

    local ToggleBtn = Instance.new("ImageButton")
    ToggleBtn.Name = "ToggleCoverButton"
    ToggleBtn.Size = UDim2.fromOffset(44, 44)
    ToggleBtn.Position = UDim2.new(0, 14, 0.5, -22)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    ToggleBtn.BorderSizePixel = 0
    ToggleBtn.Image = "rbxassetid://101767646310441"
    ToggleBtn.ScaleType = Enum.ScaleType.Crop
    ToggleBtn.Active = true
    ToggleBtn.Parent = ToggleGui

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(1, 0)
    BtnCorner.Parent = ToggleBtn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(255, 65, 65)
    BtnStroke.Thickness = 1.8
    BtnStroke.Parent = ToggleBtn

    local dragging = false
    local dragInput, dragStart, startPos
    local movedDistance = 0

    ToggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = ToggleBtn.Position
            movedDistance = 0

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    ToggleBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            movedDistance = delta.Magnitude
            ToggleBtn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    ToggleBtn.MouseButton1Click:Connect(function()
        if movedDistance < 8 then
            SetWindowVisible(not uiVisible)
        end
    end)
end

CreateFloatingToggle()

