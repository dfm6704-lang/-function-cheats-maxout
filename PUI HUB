    local JumpToggle = JumpSection:AddToggle("JumpToggle", {
        Title = "เปิดใช้งาน กระโดดสูง",
        Default = false
    })

    JumpToggle:OnChanged(function(State)
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.UseJumpPower = true
            hum.JumpPower = State and Options.JumpPowerSlider.Value or 50
        end
    end)

    JumpSection:AddToggle("InfJumpToggle", {
        Title = "กระโดดกลางอากาศไม่จำกัด (Inf Jump)",
        Default = false
    })

    UserInputService.JumpRequest:Connect(function()
